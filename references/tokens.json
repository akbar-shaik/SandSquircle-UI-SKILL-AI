{
  "$schema": "https://design-tokens.github.io/community-group/format/draft-spec.json",
  "name": "SandSquircle Design Tokens",
  "version": "1.0.0",
  "color": {
    "sand": {
      "50": { "$value": "#FBF9F6", "$type": "color" },
      "100": { "$value": "#F8F6F2", "$type": "color", "$description": "Primary Viewport Canvas" },
      "200": { "$value": "#F4EFEA", "$type": "color", "$description": "Card Dividers & Pill Tracks" },
      "300": { "$value": "#EAE2D8", "$type": "color", "$description": "Active Tab & Subtle Borders" },
      "400": { "$value": "#D8CDC0", "$type": "color", "$description": "Muted Hairline Borders" }
    },
    "charcoal": {
      "100": { "$value": "#F3F4F6", "$type": "color" },
      "200": { "$value": "#E5E7EB", "$type": "color" },
      "400": { "$value": "#9CA3AF", "$type": "color", "$description": "Placeholders" },
      "500": { "$value": "#6B7280", "$type": "color", "$description": "Subtitles & Inactive Icons" },
      "700": { "$value": "#374151", "$type": "color", "$description": "Section Titles & Form Labels" },
      "800": { "$value": "#1F2937", "$type": "color", "$description": "Dark Hero Gradient End" },
      "900": { "$value": "#111827", "$type": "color", "$description": "Primary Typography, FAB & Key CTAs" }
    },
    "teal": {
      "50": { "$value": "#F0FDFA", "$type": "color", "$description": "Active Tab Tint" },
      "600": { "$value": "#0D9488", "$type": "color", "$description": "Brand Accent & Active Navigation" },
      "700": { "$value": "#0F766E", "$type": "color", "$description": "Hover State" }
    },
    "semantic": {
      "emeraldMint": {
        "text": { "$value": "#10B981", "$type": "color" },
        "bg": { "$value": "#ECFDF5", "$type": "color" },
        "border": { "$value": "#D1FAE5", "$type": "color" }
      },
      "crimsonCoral": {
        "text": { "$value": "#EF4444", "$type": "color" },
        "bg": { "$value": "#FEF2F2", "$type": "color" },
        "border": { "$value": "#FEE2E2", "$type": "color" }
      },
      "amberSand": {
        "text": { "$value": "#F59E0B", "$type": "color" },
        "bg": { "$value": "#FFFBEB", "$type": "color" },
        "border": { "$value": "#FEF3C7", "$type": "color" }
      }
    }
  },
  "borderRadius": {
    "modal": { "$value": "32px", "$type": "dimension", "$description": "Modals & Bottom Sheets" },
    "heroCard": { "$value": "28px", "$type": "dimension", "$description": "Dark Gradient Hero Cards" },
    "card": { "$value": "26px", "$type": "dimension", "$description": "Standard Primary White Cards" },
    "miniCard": { "$value": "22px", "$type": "dimension", "$description": "Metric Summary Mini-Cards" },
    "row": { "$value": "16px", "$type": "dimension", "$description": "List Items, Form Inputs & Buttons" },
    "chip": { "$value": "12px", "$type": "dimension", "$description": "Segmented Tabs & Filter Chips" },
    "logo": { "$value": "22%", "$type": "dimension", "$description": "App Brand Squircle" },
    "pill": { "$value": "9999px", "$type": "dimension", "$description": "Floating Pill Dock, Status Badges & FAB" }
  },
  "boxShadow": {
    "softCard": {
      "$value": "0 10px 30px -4px rgba(0, 0, 0, 0.04)",
      "$type": "shadow"
    },
    "softCardHover": {
      "$value": "0 14px 34px -4px rgba(0, 0, 0, 0.07)",
      "$type": "shadow"
    },
    "pillDock": {
      "$value": "0 20px 40px -6px rgba(0, 0, 0, 0.08), 0 1px 3px 0 rgba(0, 0, 0, 0.04)",
      "$type": "shadow"
    },
    "elevatedFab": {
      "$value": "0 12px 24px -4px rgba(17, 24, 39, 0.28)",
      "$type": "shadow"
    },
    "modalSheet": {
      "$value": "0 25px 60px -12px rgba(0, 0, 0, 0.18)",
      "$type": "shadow"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": {
        "$value": ["Plus Jakarta Sans", "system-ui", "-apple-system", "sans-serif"],
        "$type": "fontFamily"
      }
    }
  }
}
